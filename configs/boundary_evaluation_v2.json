    ],
    "method_roles": [
      "raw",
      "causal_persistence_minrun5",
      "rq2_proposed_gate_v1"
    ],
    "output": "outputs/validation_boundary_matching_audit_v1",
    "result": "No TP, F1, or mean-absolute-error differences were observed between legacy greedy and optimal matching for the audited core validation summaries.",
    "test_outputs_read": false
  },
  "change_control": {
